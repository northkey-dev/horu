# Copy to .env (scripts/pi-install.sh does it for you).

# docker-compose.yml (Tailscale) or docker-compose.lan.yml (home network only, no https)
COMPOSE_FILE=docker-compose.yml

# Tailscale: login.tailscale.com -> Settings -> Keys -> Generate auth key (reusable is fine).
# In the admin console DNS page switch on MagicDNS and HTTPS certificates once.
TS_AUTHKEY=
TS_HOSTNAME=horu

# What to build into the image when you build it yourself: manga, whisper, or both ("manga,whisper"). Empty = service only.
HORU_MODULES=manga

# Your user id on the Pi (id -u / id -g), so the data folder belongs to you
PUID=1000
PGID=1000
TZ=Europe/Berlin

# The Pi's address in the home network (for the pairing page without Tailscale)
HORU_LAN_ADDRESS=

# Only if you host the phone app yourself on GitHub Pages: its address, e.g. https://you.github.io/horu/
# (leave empty: this Horu serves the app itself)
HORU_APP_URL=

# Anki lives on another computer? Its AnkiConnect address, e.g. http://192.168.1.20:8765 (leave empty: cards are made on the phone)
HORU_ANKI_URL=
