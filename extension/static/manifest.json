{
  "manifest_version": 3,
  "name": "Horu",
  "description": "Mine Japanese from anime without pausing, and see which words you do not know yet on any page.",
  "version": "1.0.1",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Horu: start recording this tab"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "words.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Start/stop recording this tab"
    },
    "record": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Start/stop recording this tab (the phone's remote start presses this)"
    },
    "toggle-highlight": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Highlight unknown Japanese words on this site"
    }
  }
}
